# Copy to .env and replace credentials and model settings before first startup.
# MySQL Compose settings. Keep KNOWFLOW_MYSQL_URL consistent with these values.
MYSQL_DATABASE=knowflow
MYSQL_USER=knowflow
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local
MYSQL_PORT=3306
KNOWFLOW_MYSQL_URL=mysql+asyncmy://knowflow:change-me-local@127.0.0.1:3306/knowflow

# Authentication and first-start seed accounts.
KNOWFLOW_JWT_SECRET=change-me-to-a-long-random-secret
KNOWFLOW_SEED_EMPLOYEE_USERNAME=employee
KNOWFLOW_SEED_EMPLOYEE_PASSWORD=change-me-employee-password
KNOWFLOW_SEED_EMPLOYEE_DISPLAY_NAME=Employee
KNOWFLOW_SEED_ADMIN_USERNAME=admin
KNOWFLOW_SEED_ADMIN_PASSWORD=change-me-admin-password
KNOWFLOW_SEED_ADMIN_DISPLAY_NAME=Administrator

# OpenAI-compatible chat endpoint. Use your provider's actual model identifier.
KNOWFLOW_CHAT_BASE_URL=https://example.invalid/v1
KNOWFLOW_CHAT_API_KEY=change-me-chat-api-key
KNOWFLOW_CHAT_MODEL=change-me-chat-model
KNOWFLOW_RUN_DEADLINE_SECONDS=600

# S3-compatible MinIO API endpoint (use the API port).
KNOWFLOW_MINIO_ENDPOINT=http://127.0.0.1:9000
KNOWFLOW_MINIO_ACCESS_KEY=change-me-minio-access-key
KNOWFLOW_MINIO_SECRET_KEY=change-me-minio-secret-key
KNOWFLOW_MINIO_BUCKET=knowflow-documents

# Elasticsearch supporting dense_vector and cosineSimilarity script search.
KNOWFLOW_ELASTICSEARCH_URL=http://127.0.0.1:9200
KNOWFLOW_ELASTICSEARCH_INDEX=knowflow-documents

# Embedding endpoint. Dimensions must match both the model and the ES index.
KNOWFLOW_EMBEDDING_BASE_URL=https://example.invalid/v1
KNOWFLOW_EMBEDDING_API_KEY=change-me-embedding-api-key
KNOWFLOW_EMBEDDING_MODEL=change-me-embedding-model
KNOWFLOW_EMBEDDING_DIMENSIONS=1024

# Rerank endpoint. See README for the required request/response format.
KNOWFLOW_RERANK_BASE_URL=https://example.invalid/v1
KNOWFLOW_RERANK_API_KEY=change-me-rerank-api-key
KNOWFLOW_RERANK_MODEL=change-me-rerank-model

# PDF limits.
KNOWFLOW_ATTACHMENT_MAX_BYTES=10485760
KNOWFLOW_SUBMISSION_MAX_BYTES=20971520
KNOWFLOW_DOCUMENT_MAX_PAGES=100

# Resolve these relative paths from the repository root, or use absolute paths.
# Keep online mode during model preparation, then set HF_HUB_OFFLINE=1.
KNOWFLOW_DOCLING_HF_HOME=.hf-cache
HF_HOME=.hf-cache
HF_HUB_OFFLINE=0
DOCLING_ARTIFACTS_PATH=.docling-models
