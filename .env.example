# Local/VM development example only. Replace every change-me value locally.
MYSQL_DATABASE=knowflow
MYSQL_USER=knowflow
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local
MYSQL_PORT=3306

KNOWFLOW_MYSQL_URL=mysql+asyncmy://knowflow:change-me-local@127.0.0.1:3306/knowflow
KNOWFLOW_JWT_SECRET=change-me-to-a-long-random-secret
KNOWFLOW_SEED_EMPLOYEE_USERNAME=employee
KNOWFLOW_SEED_EMPLOYEE_PASSWORD=change-me-employee-password
KNOWFLOW_SEED_EMPLOYEE_DISPLAY_NAME=Employee
KNOWFLOW_SEED_ADMIN_USERNAME=admin
KNOWFLOW_SEED_ADMIN_PASSWORD=change-me-admin-password
KNOWFLOW_SEED_ADMIN_DISPLAY_NAME=Administrator

KNOWFLOW_CHAT_BASE_URL=https://example.invalid/v1
KNOWFLOW_CHAT_API_KEY=change-me-chat-api-key
KNOWFLOW_CHAT_MODEL=qwen3.7-plus-2026-05-26
